{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "Passport",
  "description": "Connect your work apps to Claude, Cursor, ChatGPT, and more, with clear rules and a record of every action.",
  "colors": {
    "primary": "#C93A6B",
    "light": "#FF8A5C",
    "dark": "#C93A6B"
  },
  "favicon": "/favicon.svg",
  "appearance": {
    "default": "light"
  },
  "navigation": {
    "groups": [
      {
        "group": "Start here",
        "pages": ["index", "quickstart/developer", "quickstart/member", "quickstart/admin", "quickstart/cli"]
      },
      {
        "group": "In Passport",
        "pages": ["member/work", "member/agents", "member/apps", "member/safety"]
      },
      {
        "group": "How it works",
        "pages": [
          "concepts/model",
          "member/undo",
          "member/cli-hook",
          "member/scan",
          "member/updates",
          "concepts/status-words",
          "troubleshooting"
        ]
      },
      {
        "group": "Manage a workspace",
        "pages": [
          "admin/people-and-teams",
          "admin/settings",
          "admin/rollout",
          "admin/slack-and-approvers",
          "admin/data-checks",
          "admin/managed-api-integrations",
          "billing"
        ]
      },
      {
        "group": "Enterprise security",
        "pages": ["enterprise/sso-oidc", "enterprise/scim", "enterprise/siem-export"]
      },
      {
        "group": "Self-hosting",
        "pages": ["self-host", "security/network"]
      },
      {
        "group": "Technical reference",
        "pages": ["concepts/discovery", "benchmarks/context-efficiency"]
      }
    ]
  },
  "navbar": {
    "links": [
      {
        "label": "Privacy",
        "href": "https://passportmcp.com/privacy"
      },
      {
        "label": "Security",
        "href": "https://passportmcp.com/security"
      }
    ],
    "primary": {
      "type": "button",
      "label": "passportmcp.com",
      "href": "https://passportmcp.com"
    }
  },
  "redirects": [
    {
      "source": "/member/home",
      "destination": "/member/work"
    },
    {
      "source": "/member/inbox",
      "destination": "/member/work#waiting-on-you"
    },
    {
      "source": "/member/sessions",
      "destination": "/member/work#tasks"
    },
    {
      "source": "/member/ai-setup",
      "destination": "/member/agents"
    },
    {
      "source": "/admin/activity-and-audit",
      "destination": "/member/work#history"
    },
    {
      "source": "/admin/client-fleet",
      "destination": "/member/agents"
    },
    {
      "source": "/admin/agents-and-access",
      "destination": "/member/agents#agent-tokens"
    },
    {
      "source": "/admin/approvals-and-requests",
      "destination": "/member/apps"
    },
    {
      "source": "/admin/team-setups",
      "destination": "/member/agents"
    },
    {
      "source": "/admin/bundles",
      "destination": "/member/apps"
    },
    {
      "source": "/admin/invitations",
      "destination": "/admin/people-and-teams#invite-people"
    },
    {
      "source": "/admin/discovered-agents",
      "destination": "/member/scan"
    },
    {
      "source": "/admin/openapi-import",
      "destination": "/admin/managed-api-integrations"
    },
    {
      "source": "/admin/client-defaults",
      "destination": "/member/agents"
    },
    {
      "source": "/admin/discover",
      "destination": "/member/scan"
    },
    {
      "source": "/admin/inventory",
      "destination": "/member/scan"
    },
    {
      "source": "/admin/guardrails",
      "destination": "/admin/data-checks"
    }
  ]
}
